# Copier ce fichier en ".env" et ajuster si besoin.
# Aucune clé API n'est requise pour le MVP : DVF+ (Cerema), DPE (ADEME) et
# l'API Adresse (BAN) sont toutes en open data, sans authentification.

PORT=4000

# Ville pilote (code INSEE). Toulouse = 31555.
PILOT_CITY_CODE_INSEE=31555
PILOT_CITY_NAME=Toulouse

# Base URLs des APIs publiques — modifiables si le Cerema fait évoluer son
# infrastructure (apidf-preprod.cerema.fr est un environnement de préprod,
# sans SLA garanti : le service peut renvoyer des 503 intermittents).
DVF_API_BASE_URL=https://apidf-preprod.cerema.fr
DPE_API_BASE_URL=https://data.ademe.fr/data-fair/api/v1/datasets/dpe03existant
BAN_API_BASE_URL=https://api-adresse.data.gouv.fr

# Fenêtre temporelle des transactions DVF+ à ingérer.
DVF_ANNEE_MIN=2022

# Chemin du fichier de données local (remplace une vraie base pour le MVP).
DATA_DIR=./data
